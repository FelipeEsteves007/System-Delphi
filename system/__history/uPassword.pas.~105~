unit uPassword;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.ComCtrls, Vcl.StdCtrls, Vcl.Buttons, Vcl.ExtCtrls, FireDAC.Stan.Intf, FireDAC.Stan.Option, FireDAC.Stan.Param, FireDAC.Stan.Error,
  FireDAC.DatS, FireDAC.Phys.Intf, FireDAC.DApt.Intf, FireDAC.Stan.Async, FireDAC.DApt, Data.DB, FireDAC.Comp.DataSet, FireDAC.Comp.Client;

type
  TfmPassword = class(TForm)
    pnFundo: TPanel;
    PassWord: TLabel;
    sbOk: TSpeedButton;
    edPassword: TEdit;
    sbClose: TSpeedButton;
    Label1: TLabel;
    edUser: TEdit;
    qUSer: TFDQuery;
    qUSerID: TIntegerField;
    qUSerUSER_NAME: TStringField;
    qUSerPASSWORD: TStringField;
    qUSerUSER_TYPE: TStringField;
    procedure sbCloseClick(Sender: TObject);
    procedure sbOkClick(Sender: TObject);
    procedure FormCreate(Sender: TObject);
  private
    var i: integer;
    { Private declarations }
  public
    { Public declarations }
  end;

var
  fmPassword: TfmPassword;

implementation

{$R *.dfm}

uses uTables;

procedure TfmPassword.sbOkClick(Sender: TObject);
begin
  if (Trim(edUser.Text) = '') then
  begin
    MessageDlg('The user is empty!', mtInformation, [mbOK], 0);
    Exit;
  end;

  if Trim(edPassword.Text) = '' then
  begin
    MessageDlg('The password is empty!', mtInformation, [mbOK], 0);
    Exit;
  end;

  qUSer.Close;
  qUSer.SQL.Clear;
  with qUSer.SQL do
  begin
    Add(' SELECT ID, ' +
        '        USER_NAME, ' +
        '        PASSWORD, ' +
        '        USER_TYPE ' +
        ' FROM USERS ' +
        ' WHERE USER_NAME = :USER ' +
        ' AND PASSWORD = :PASS ');
  end;
  qUSer.ParamByName('USER').AsString := edUser.Text;
  qUSer.ParamByName('PASS').AsString := edPassword.Text;
  qUSer.Open;

  if not qUSer.IsEmpty  then
  begin
    if (qUSerUSER_TYPE.AsString <> 'A') AND (qUSerUSER_TYPE.AsString <> 'S') then
    begin
      MessageDlg('This user does not have permission!', mtError, [mbClose], 0);
      Exit;
    end else begin
      ModalResult := mrOk;
      Exit;
    end;
   end;

  i :=  i - 1;

   if (i > 0) then
   begin
     Application.MessageBox(Pchar('Attention: you have  '+i.ToString+' more attempts!'), 'Warning', MB_OK + MB_ICONWARNING);
     edPassword.Clear;
     edUser.Clear;
     edUser.SetFocus;
   end else begin
     Application.MessageBox('BLOCK', 'Blocked', MB_OK + MB_ICONERROR);
     ModalResult := mrCancel;
     Application.Terminate;
   end;
end;

procedure TfmPassword.FormCreate(Sender: TObject);
begin
  i := 4;
end;

procedure TfmPassword.sbCloseClick(Sender: TObject);
begin
  ModalResult := mrCancel;
end;

end.

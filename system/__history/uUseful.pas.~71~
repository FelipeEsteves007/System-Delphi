unit uUseful;

interface

uses SysUtils, Vcl.Graphics, System.UiTypes, Vcl.StdCtrls, Vcl.ExtCtrls;

function JustNumbers(Texto: String): String;
function Cpf(num: String): Boolean;
procedure JustNumberEdit(var Key: Char);
procedure JustCharEdit(var Key: Char);
procedure Required(lb: TLabel);
procedure ClearLabl(pn: TPanel);

implementation

function JustNumbers(Texto: String): String;
var I: integer; S: string;
begin
   S := '';
   for I := 0 To Length(Texto)-1 do if CharInSet(Texto.Chars[i],['0'..'9']) then S := S + Texto.Chars[i];
   result := S;
end;

function Cpf(num: String): Boolean;
var
 n1,n2,n3,n4,n5,n6,n7,n8,n9: Integer;
 d1,d2: Integer;
 digitado, calculado: String;
begin
   if Length(JustNumbers(num)) <> 11 then
   begin
      Result := False;
      Exit;
   end;
   n1:=StrToInt(num[1]);
   n2:=StrToInt(num[2]);
   n3:=StrToInt(num[3]);
   n4:=StrToInt(num[4]);
   n5:=StrToInt(num[5]);
   n6:=StrToInt(num[6]);
   n7:=StrToInt(num[7]);
   n8:=StrToInt(num[8]);
   n9:=StrToInt(num[9]);
   d1:=n9*2+n8*3+n7*4+n6*5+n5*6+n4*7+n3*8+n2*9+n1*10;
   d1:=11-(d1 mod 11);
   if d1>=10 then d1:=0;
   d2:=d1*2+n9*3+n8*4+n7*5+n6*6+n5*7+n4*8+n3*9+n2*10+n1*11;
   d2:=11-(d2 mod 11);
   if d2>=10 then d2:=0;
   calculado:=inttostr(d1)+inttostr(d2);
   digitado:=num[10]+num[11];
   if calculado=digitado then
      Result := True
   else
      Result := False;
end;


procedure JustNumberEdit(var Key: Char);
begin
  if not (Key in ['0'..'9', #8]) then
      Key := #0;
end;


procedure JustCharEdit(var Key: Char);
begin
   if (Key in ['1'..'9']) then
  Key := #0;
end;

procedure Required(lb: TLabel);
begin
  if Assigned(lb)then
  begin
    if lb.Tag = 1
      then lb.Font.Color := clRed;
  end;
end;

procedure ClearLabl(pn: TPanel);
var I: Integer;
begin
  for I := 0 to pn.ControlCount - 1 do
  begin
    if pn.Controls[I] is TLabel then
    begin
      if TLabel(pn.Controls[I]).Tag = 1 then
      begin
        TLabel(pn.Controls[I]).Font.Color := clWindowText;
      end;
    end;
  end;
end;

end.

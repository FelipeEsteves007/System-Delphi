      Origin = 'COST_PRICE'
      DisplayFormat = '$#,##0.00'
      Precision = 18
      Size = 2
    end
    object qProductSALE_PRICE: TFMTBCDField
      FieldName = 'SALE_PRICE'
      Origin = 'SALE_PRICE'
      DisplayFormat = '$#,##0.00'
      Precision = 18
      Size = 2
    end
    object qProductLOCATION: TStringField
      FieldName = 'LOCATION'
      Origin = 'LOCATION'
      Size = 50
    end
    object qProductKIT: TStringField
      FieldName = 'KIT'
      Origin = 'KIT'
      Size = 1
    end
    object qProductACTIVE: TStringField
      FieldName = 'ACTIVE'
      Origin = '"ACTIVE"'
      Size = 1
    end
    object qProductREGISTRATION_DATE: TDateField

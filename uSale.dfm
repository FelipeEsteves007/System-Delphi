      Precision = 18
      Size = 3
    end
    object qSalesDISCOUNT: TFMTBCDField
      FieldName = 'DISCOUNT'
      Origin = 'DISCOUNT'
      Precision = 18
      Size = 3
    end
    object qSalesTOTAL: TFMTBCDField
      FieldName = 'TOTAL'
      Origin = 'TOTAL'
      DisplayFormat = '$#,##0.00'
      Precision = 18
      Size = 3
    end
    object qSalesSALE_TYPE: TStringField
      FieldName = 'SALE_TYPE'
      Origin = 'SALE_TYPE'
      Size = 1
    end
    object qSalesNATURE_OP: TStringField

  object qSales: TFDQuery
    Active = True
    BeforePost = qSalesBeforePost
    Connection = Tables.FDConnection
    SQL.Strings = (
      'select S.ID,'
      '       S.CUSTOMER_ID,'
      '       S.SALE_DATE,'
      '       S.SUBTOTAL,'
      '       S.DISCOUNT,'
      '       S.TOTAL,'
      '       S.SALE_TYPE,'
      '       S.NATURE_OP,'
      '       S.CATEGORY_SALE,'
      '       S.SELLER_ID'
      'from SALES S  ')
    Left = 1008
    Top = 57
    object qSalesID: TIntegerField
      AutoGenerateValue = arAutoInc
      FieldName = 'ID'
      Origin = 'ID'
      ProviderFlags = [pfInUpdate, pfInWhere, pfInKey]
    end
